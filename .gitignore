# Runtime locks
/upstream/db/txn-current-lock
/upstream/db/write-lock

# In-progress transactions (partial commits)
/upstream/db/txns/
/upstream/db/tmp/

# In-progress revision writes
/upstream/db/revprops/tmp/

# Lock directory used by some SVN versions
/upstream/locks/db-logs.lock
/upstream/locks/db.lock